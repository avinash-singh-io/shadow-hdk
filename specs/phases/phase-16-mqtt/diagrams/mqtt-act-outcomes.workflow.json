      "route": "drop"
    },
    {
      "id": "to-publish",
      "from": "ensure",
      "to": "publish",
      "variant": "emphasis"
    },
    {
      "id": "not-there",
      "from": "ensure",
      "to": "unreachable",
      "label": "broker not there",
