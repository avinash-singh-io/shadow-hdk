{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "MQTT Act — What Each Outcome Becomes",
    "quality_profile": "showcase",
    "views": [
      { "id": "happy-path", "label": "The receipt", "focus": ["invoke", "ensure", "publish", "puback", "await_ack", "device_ack", "acted"], "note": "Lease, link, publish, the broker's word, the device's word, the receipt." },
      { "id": "failures", "label": "Every outcome the step can observe", "focus": ["refused", "unreachable", "no_puback", "no_ack", "acted"], "note": "The runtime lane is the complete list of observations an actuator step can produce." }
    ]
  },
  "lanes": [
    { "id": "runtime", "label": "Runtime — what the step observes" },
    { "id": "adapter", "label": "Adapter — MqttActuator / MqttLink" },
    { "id": "world", "label": "Broker + device" }
  ],
  "phases": [
    { "id": "before", "label": "Before the act", "fromCol": 0, "toCol": 2 },
    { "id": "during", "label": "The act", "fromCol": 3, "toCol": 4, "variant": "emphasis" },
    { "id": "after", "label": "The record", "fromCol": 5, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["invoke", "ensure", "publish", "puback", "await_ack", "acted"],
  "nodes": [
    { "id": "invoke", "lane": "runtime", "col": 0, "type": "backend", "label": "Invoke · lease read", "sublabel": "time and money left?", "width": 150 },
    { "id": "refused", "lane": "runtime", "col": 1, "type": "security", "label": "Refused", "sublabel": "world untouched", "width": 150 },
    { "id": "unreachable", "lane": "runtime", "col": 2, "type": "security", "label": "Failed: unreachable", "sublabel": "nothing published", "width": 150 },
    { "id": "no_puback", "lane": "runtime", "col": 3, "type": "security", "label": "Failed: no PUBACK", "sublabel": "link broken; no resend", "width": 150 },
    { "id": "no_ack", "lane": "runtime", "col": 4, "type": "security", "label": "Failed: no ack", "sublabel": "kept; command taken", "width": 150 },
    { "id": "acted", "lane": "runtime", "col": 5, "type": "backend", "label": "Acted receipt", "sublabel": "key · exit · grounds", "width": 150 },
    { "id": "ensure", "lane": "adapter", "col": 2, "type": "backend", "label": "Ensure the link", "sublabel": "connect if needed", "width": 150 },
    { "id": "publish", "lane": "adapter", "col": 3, "type": "messagebus", "label": "PUBLISH QoS 1", "sublabel": "{key, argv}", "width": 150 },
    { "id": "await_ack", "lane": "adapter", "col": 4, "type": "backend", "label": "Settle the ack", "sublabel": "wait on ack_topic", "width": 150 },
    { "id": "puback", "lane": "world", "col": 3, "type": "messagebus", "label": "PUBACK", "sublabel": "the broker's word", "width": 150 },
    { "id": "device_ack", "lane": "world", "col": 4, "type": "external", "label": "Device answers", "sublabel": "{key, id, exit}", "width": 150 }
  ],
  "edges": [
    { "id": "spent", "from": "invoke", "to": "refused", "label": "lease spent", "variant": "security", "role": "error" },
    { "id": "covered", "from": "invoke", "to": "ensure", "label": "lease can cover it", "variant": "emphasis" },
    { "id": "not-there", "from": "ensure", "to": "unreachable", "label": "ConnectionError", "variant": "security", "role": "error" },
    { "id": "to-publish", "from": "ensure", "to": "publish", "variant": "emphasis" },
    { "id": "taken", "from": "publish", "to": "puback", "label": "broker takes it", "variant": "emphasis" },
    { "id": "puback-timeout", "from": "publish", "to": "no_puback", "label": "timeout", "variant": "security", "role": "error" },
    { "id": "settle", "from": "puback", "to": "await_ack", "variant": "emphasis", "fromSide": "right", "toSide": "left" },
    { "id": "answered", "from": "device_ack", "to": "await_ack", "label": "key matches", "role": "return" },
    { "id": "ack-timeout", "from": "await_ack", "to": "no_ack", "label": "timeout", "variant": "security", "role": "error" },
    { "id": "receipt", "from": "await_ack", "to": "acted", "label": "Ack(id, exit)", "variant": "emphasis" }
  ],
  "cards": [
    { "dot": "emerald", "title": "Two exits for a receipt", "items": ["Without an ack topic the receipt says exit: published — the broker's word is all there is", "With one, the receipt carries the device's own id and exit, matched by the run's key"] },
    { "dot": "rose", "title": "Four failures, four consequences", "items": ["Refused: the lease is spent; nothing reaches the adapter", "ConnectionError: nothing published; the link stays unopened", "No PUBACK: the link is broken so the queued command dies with the session", "No ack after PUBACK: the link is kept; the command certainly reached the broker"] }
  ]
}
