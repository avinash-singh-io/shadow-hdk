      "variant": "emphasis"
    },
    {
      "id": "puback-timeout",
      "from": "publish",
      "to": "no_puback",
      "label": "timeout",
      "variant": "security",
      "role": "error"
    },
    {
      "id": "answered",
      "from": "device_ack",
      "to": "await_ack",
      "label": "key matches",
      "role": "return",
      "route": "drop"
    },
    {
      "id": "receipt",
      "from": "await_ack",
      "to": "acted",
      "label": "Ack(id, exit)",
      "variant": "emphasis"
    },
    {
      "id": "ack-timeout",
      "from": "await_ack",
      "to": "no_ack",
      "label": "timeout",
      "variant": "security",
      "role": "error"
