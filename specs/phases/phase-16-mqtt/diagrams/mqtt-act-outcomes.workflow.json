  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Two exits for a receipt",
      "items": [
        "Without an ack topic the receipt says exit: published \u2014 the broker's word is all there is",
        "With one, the receipt carries the device's own id and exit, matched by the run's key"
      ]
    },
    {
      "dot": "rose",
      "title": "Four failures, four consequences",
      "items": [
        "Refused: the lease is spent; nothing reaches the adapter",
        "ConnectionError: nothing published; the link stays unopened",
        "No PUBACK: the link is broken so the queued command dies with the session",
        "No ack after PUBACK: the link is kept; the command certainly reached the broker"
      ]
    }
  ]
}