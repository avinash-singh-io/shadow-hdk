  "cards": [
    {
      "dot": "cyan",
      "title": "Layers point one way",
      "items": [
        "kernel \u2190 runtime \u2190 adapters; the runtime never imports an adapter",
        "adapters/mqtt imports the device contract from runtime/devices.py, not adapters/devices",
        "The act itself lives in DeviceComponents and is shared by every protocol"
      ]
    },
    {
      "dot": "emerald",
      "title": "Three roles, one contract",
      "items": [
        "Sensor.read \u2192 Reading; Actuator.command \u2192 Ack; Witness.overheard \u2192 Overheard",
        "A sensor and a witness read {world}; an actuator writes it irreversibly",
        "Posture is stamped by the runtime from the registration, never by the adapter"
      ]
    },
    {
      "dot": "rose",
      "title": "What the adapter never does",
      "items": [
        "Never re-sends a command whose PUBACK did not come \u2014 a failed act breaks the link",
        "Never reopens a closed link behind the caller's back",
        "Never blocks the event loop \u2014 paho's thread does the socket work, waits go to a worker"
      ]
    }
  ]
