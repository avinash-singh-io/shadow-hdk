  "cards": [
    {
      "dot": "emerald",
      "title": "Parking is not pausing a process",
      "items": [
        "A parked run is a checkpoint on disk, not an object left running in memory",
        "The same mechanism serves a governance Ask, an Await on a slow job, and a sub-agent held between messages",
        "It can be resumed by a different process, on a different machine, minutes or days later"
      ]
    },
    {
      "dot": "cyan",
      "title": "The lease is the clock and the wallet",
      "items": [
        "A ceiling on steps, wall time and money; a floor on effort before the agent may give up",
        "A child's lease is carved from the parent's, so fanning out changes shape but never the ceiling",
        "The ceiling always beats the floor, because the ceiling is someone's money"
      ]
    },
    {
      "dot": "rose",
      "title": "Five endings, each named",
      "items": [
        "completed, lease_exhausted, gave_up, cancelled, failed",
        "The record carries the words of whoever stopped it, so a closed tab reads differently from a spent budget",
        "gave_up is the agent's own answer, and the floor is what stops it being given too early"
      ]
    }
  ]
