  "cards": [
    {
      "dot": "cyan",
      "title": "Arrows point one way",
      "items": [
        "The kernel depends on nothing: frozen dataclasses and protocols, no I/O and no clock",
        "The runtime depends only on the kernel and never imports an adapter",
        "Adapters depend on the runtime and never on each other \u2014 each is its own package"
      ]
    },
    {
      "dot": "emerald",
      "title": "Six ports, and what each is for",
      "items": [
        "Model thinks; Components can be invoked; Governance judges; Sink receives proposals",
        "Observer is the only channel out; a sixth port, Clock, holds the one non-determinism so a replay costs nothing",
        "The registry is the union of every component port, recomputed every step"
      ]
    },
    {
      "dot": "rose",
      "title": "Where the boundary falls",
      "items": [
        "Mechanism here, policy and content in the product",
        "Model adapters here; which provider and whose key, there",
        "The rules engine here; the rules themselves, there"
      ]
    }
  ]
