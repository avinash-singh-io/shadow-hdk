  "cards": [
    {
      "dot": "cyan",
      "title": "The plan is a value, not a script",
      "items": [
        "The model's tool calls become a Composition \u2014 Invoke, Await, Sequence, FanOut, Until",
        "A composition is compiled to a graph and executed by the engine; the runtime never interprets it",
        "It is emitted as an event every time it changes, so plan-versus-actual costs nothing"
      ]
    },
    {
      "dot": "rose",
      "title": "Two kinds of write, and only one is forbidden",
      "items": [
        "Changing the world happens through a component whose effects are declared and judged",
        "Changing the host's record happens only by proposing; the host's own gate decides",
        "The runtime has no write path into any durable store \u2014 that is the whole of propose, never commit"
      ]
    },
    {
      "dot": "emerald",
      "title": "What the model is allowed to see",
      "items": [
        "The catalogue is the registry narrowed by the ceiling in force, so a forbidden tool is not merely refused \u2014 it is invisible",
        "Handles carry real values between steps, so a large result is never flattened into tokens",
        "An act on the world leaves a receipt with its key, its exit and the authority it ran under"
      ]
    }
  ]
