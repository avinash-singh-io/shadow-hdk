{
  "$defs": {
    "Acted": {
      "description": "The receipt of a world-effect (`08` \u00a7249: `ActReceipt`). *The only place anything happens\noutside the log* \u2014 so every one of them is attributed and re-checkable.\n\n`foreign_id` is what the world called it; `idempotency_key` is what we called it, so a retry\ncan be told from a second act; `exit` is how it ended in the world's own vocabulary; `grounds`\nis what it was performed under \u2014 the argv, the lease remaining, the warrant \u2014 so an auditor can\nask not only *what happened* but *on whose authority at that moment*.",
      "properties": {
        "exit": {
          "title": "Exit",
          "type": "string"
        },
        "foreign_id": {
          "title": "Foreign Id",
          "type": "string"
        },
        "grounds": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "kind": {
          "const": "acted",
          "default": "acted",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "foreign_id",
        "idempotency_key",
        "exit"
      ],
      "title": "Acted",
      "type": "object"
    },
    "ApprovalRequest": {
      "description": "The step paused; whoever implements governance decides what asking means.\n\n`component` and `inputs` say what the question is about (BUG-026) \u2014 an agent surfacing a\nchild's question passes on what that child was about to do, so the person sees it.",
      "properties": {
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "inputs": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "approval_request",
          "default": "approval_request",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "handle"
      ],
      "title": "ApprovalRequest",
      "type": "object"
    },
    "Completed": {
      "properties": {
        "kind": {
          "const": "completed",
          "default": "completed",
          "title": "Kind",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "title": "Completed",
      "type": "object"
    },
    "EffectRecorded": {
      "description": "One public fact from the append-only transaction history (D101-D104).\n\nThis is deliberately a generic status event rather than one event class per transition. A\nclient can render the exact history\u2014including an explicit ``unknown``\u2014without reimplementing\ntransaction inference or receiving credentials, callbacks or hidden authorizer state.",
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "authorization_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authorization Id"
        },
        "detail": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "kind": {
          "const": "effect_recorded",
          "default": "effect_recorded",
          "title": "Kind",
          "type": "string"
        },
        "recorded_at": {
          "default": "",
          "title": "Recorded At",
          "type": "string"
        },
        "replayed": {
          "default": false,
          "title": "Replayed",
          "type": "boolean"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "stage_digest": {
          "title": "Stage Digest",
          "type": "string"
        },
        "status": {
          "enum": [
            "staged",
            "authorized",
            "executing",
            "receipt",
            "refused",
            "failed",
            "unknown",
            "reconciled"
          ],
          "title": "Status",
          "type": "string"
        },
        "step": {
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "seq",
        "at",
        "step",
        "attempt_id",
        "status",
        "stage_digest"
      ],
      "title": "EffectRecorded",
      "type": "object"
    },
    "Failed": {
      "properties": {
        "error": {
          "title": "Error",
          "type": "string"
        },
        "kind": {
          "const": "failed",
          "default": "failed",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "title": "Failed",
      "type": "object"
    },
    "InputRequest": {
      "description": "The step paused for the person's answer to a question of the agent's own (D61).",
      "properties": {
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "kind": {
          "const": "input_request",
          "default": "input_request",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "handle"
      ],
      "title": "InputRequest",
      "type": "object"
    },
    "Item": {
      "description": "One thing the agent did, with what it thought first and what it cost.\n\n`children` are the steps of every run spawned while this step was executing, in order, each\nwith children of its own. `observation` is the whole observation \u2014 a projection is not the\nplace to summarise; the offloading rule (Group 4) is where size is handled, before it gets here.",
      "properties": {
        "at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At"
        },
        "children": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Item"
          },
          "title": "Children",
          "type": "array"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/EffectRecorded"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "inputs": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "observation": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "acted": "#/$defs/Acted",
                  "approval_request": "#/$defs/ApprovalRequest",
                  "completed": "#/$defs/Completed",
                  "failed": "#/$defs/Failed",
                  "input_request": "#/$defs/InputRequest",
                  "pending": "#/$defs/Pending",
                  "refused": "#/$defs/Refused"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Completed"
                },
                {
                  "$ref": "#/$defs/Refused"
                },
                {
                  "$ref": "#/$defs/ApprovalRequest"
                },
                {
                  "$ref": "#/$defs/InputRequest"
                },
                {
                  "$ref": "#/$defs/Failed"
                },
                {
                  "$ref": "#/$defs/Pending"
                },
                {
                  "$ref": "#/$defs/Acted"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation"
        },
        "outcome": {
          "default": "running",
          "enum": [
            "running",
            "completed",
            "refused",
            "approval_requested",
            "input_requested",
            "failed",
            "pending",
            "acted"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "type": "string"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanAdmitted"
            },
            {
              "$ref": "#/$defs/PlanRefused"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "reasoning": {
          "default": "",
          "title": "Reasoning",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "step": {
          "title": "Step",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "run_id",
        "step"
      ],
      "title": "Item",
      "type": "object"
    },
    "JsonValue": {},
    "Pending": {
      "description": "The answer arrives later, under this handle.",
      "properties": {
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "kind": {
          "const": "pending",
          "default": "pending",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "handle"
      ],
      "title": "Pending",
      "type": "object"
    },
    "PlanAdmitted": {
      "description": "A whole plan admitted before it compiled (D108): its digest, the authority it was admitted\nunder, the limits it fit \u2014 and whether it amended a plan already running (D116).",
      "properties": {
        "amendment": {
          "default": false,
          "title": "Amendment",
          "type": "boolean"
        },
        "asks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Asks",
          "type": "array"
        },
        "at": {
          "title": "At",
          "type": "string"
        },
        "authority_digest": {
          "default": "",
          "title": "Authority Digest",
          "type": "string"
        },
        "kind": {
          "const": "plan_admitted",
          "default": "plan_admitted",
          "title": "Kind",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/PlanLimits",
          "default": {
            "depth": null,
            "fan_out": null,
            "steps": null
          }
        },
        "plan_digest": {
          "title": "Plan Digest",
          "type": "string"
        },
        "refusals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Refusals",
          "type": "array"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "step": {
          "default": "",
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "seq",
        "at",
        "plan_digest"
      ],
      "title": "PlanAdmitted",
      "type": "object"
    },
    "PlanLimits": {
      "description": "How much plan a host, a mode or a parent admits. `None` is unbounded.\n\nOrder-bearing, like an effect profile: `meet` takes the narrower of each field, so limits\ncompose without a review and the narrowing proof covers them.",
      "properties": {
        "depth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Depth"
        },
        "fan_out": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fan Out"
        },
        "steps": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Steps"
        }
      },
      "title": "PlanLimits",
      "type": "object"
    },
    "PlanMismatch": {
      "description": "One way a plan does not fit, as data a host or a planner can act on.",
      "properties": {
        "axis": {
          "enum": [
            "depth",
            "fan_out",
            "steps",
            "component"
          ],
          "title": "Axis",
          "type": "string"
        },
        "found": {
          "title": "Found",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "string"
        },
        "step": {
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "axis",
        "step",
        "required",
        "found"
      ],
      "title": "PlanMismatch",
      "type": "object"
    },
    "PlanRefused": {
      "description": "A whole plan refused before anything ran \u2014 every mismatch, in the stable order. The\nplanner hears this as an observation and decides; nothing was trimmed (D111).",
      "properties": {
        "amendment": {
          "default": false,
          "title": "Amendment",
          "type": "boolean"
        },
        "at": {
          "title": "At",
          "type": "string"
        },
        "kind": {
          "const": "plan_refused",
          "default": "plan_refused",
          "title": "Kind",
          "type": "string"
        },
        "mismatches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlanMismatch"
          },
          "title": "Mismatches",
          "type": "array"
        },
        "plan_digest": {
          "title": "Plan Digest",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "step": {
          "default": "",
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "seq",
        "at",
        "plan_digest"
      ],
      "title": "PlanRefused",
      "type": "object"
    },
    "Refused": {
      "properties": {
        "kind": {
          "const": "refused",
          "default": "refused",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "Refused",
      "type": "object"
    },
    "Usage": {
      "description": "What the call cost. A model adapter that cannot say reports ``None`` for the field it does\nnot know \u2014 *unknown*, never zero (10 \u00a75 R2).",
      "properties": {
        "cache_read_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Read Tokens"
        },
        "cache_write_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write Tokens"
        },
        "cost_cents": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Cents"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        }
      },
      "title": "Usage",
      "type": "object"
    }
  },
  "$ref": "#/$defs/Item"
}
