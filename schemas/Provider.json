          "default": false,
          "title": "Resident",
          "type": "boolean"
        },
        "resume_args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Resume Args",
          "type": "array"
        },
        "say_at": {
          "default": "",
