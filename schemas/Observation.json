{
  "$defs": {
    "Acted": {
      "description": "The receipt of a world-effect (`08` \u00a7249: `ActReceipt`). *The only place anything happens\noutside the log* \u2014 so every one of them is attributed and re-checkable.\n\n`foreign_id` is what the world called it; `idempotency_key` is what we called it, so a retry\ncan be told from a second act; `exit` is how it ended in the world's own vocabulary; `grounds`\nis what it was performed under \u2014 the argv, the lease remaining, the warrant \u2014 so an auditor can\nask not only *what happened* but *on whose authority at that moment*.",
      "properties": {
        "exit": {
          "title": "Exit",
          "type": "string"
        },
        "foreign_id": {
          "title": "Foreign Id",
          "type": "string"
        },
        "grounds": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "idempotency_key": {
          "title": "Idempotency Key",
          "type": "string"
        },
        "kind": {
          "const": "acted",
          "default": "acted",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "foreign_id",
        "idempotency_key",
        "exit"
      ],
      "title": "Acted",
      "type": "object"
    },
    "ApprovalRequest": {
      "description": "The step paused; whoever implements governance decides what asking means.\n\n`component` and `inputs` say what the question is about (BUG-026) \u2014 an agent surfacing a\nchild's question passes on what that child was about to do, so the person sees it.",
      "properties": {
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "inputs": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "approval_request",
          "default": "approval_request",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "handle"
      ],
      "title": "ApprovalRequest",
      "type": "object"
    },
    "Completed": {
      "properties": {
        "kind": {
          "const": "completed",
          "default": "completed",
          "title": "Kind",
          "type": "string"
        },
        "output": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "title": "Completed",
      "type": "object"
    },
    "Failed": {
      "properties": {
        "error": {
          "title": "Error",
          "type": "string"
        },
        "kind": {
          "const": "failed",
          "default": "failed",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "error"
      ],
      "title": "Failed",
      "type": "object"
    },
    "InputRequest": {
      "description": "The step paused for the person's answer to a question of the agent's own (D61).",
      "properties": {
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "kind": {
          "const": "input_request",
          "default": "input_request",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        }
      },
      "required": [
        "question",
        "handle"
      ],
      "title": "InputRequest",
      "type": "object"
    },
    "JsonValue": {},
    "Pending": {
      "description": "The answer arrives later, under this handle.",
      "properties": {
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "kind": {
          "const": "pending",
          "default": "pending",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "handle"
      ],
      "title": "Pending",
      "type": "object"
    },
    "Refused": {
      "properties": {
        "kind": {
          "const": "refused",
          "default": "refused",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "Refused",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "acted": "#/$defs/Acted",
      "approval_request": "#/$defs/ApprovalRequest",
      "completed": "#/$defs/Completed",
      "failed": "#/$defs/Failed",
      "input_request": "#/$defs/InputRequest",
      "pending": "#/$defs/Pending",
      "refused": "#/$defs/Refused"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Completed"
    },
    {
      "$ref": "#/$defs/Refused"
    },
    {
      "$ref": "#/$defs/ApprovalRequest"
    },
    {
      "$ref": "#/$defs/InputRequest"
    },
    {
      "$ref": "#/$defs/Failed"
    },
    {
      "$ref": "#/$defs/Pending"
    },
    {
      "$ref": "#/$defs/Acted"
    }
  ]
}
