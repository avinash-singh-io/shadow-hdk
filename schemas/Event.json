          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "steps_spent": {
          "title": "Steps Spent",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "seq",
        "at",
        "child_run_id",
        "handle",
        "steps_spent"
      ],
      "title": "Held",
      "type": "object"
    },
