    "Held": {
      "description": "A child parked instead of ending, and its parent is keeping it (D16).\n\nWithout this a host would have to infer holding from the *absence* of `Ended` \u2014 which a child\nthat died silently also looks like. `steps_spent` is what the child cost on the way in; it is\nnot a reservation, because a parked run settles what it did not use back to its parent.",
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "child_run_id": {
          "title": "Child Run Id",
          "type": "string"
        },
        "handle": {
