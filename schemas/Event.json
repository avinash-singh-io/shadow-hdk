    "Observed": {
      "description": "What a step observed, and the **posture** of what produced it (D30): `controlled` is *we\ngated it before it happened*; `observed` is *evidence recorded after something else acted* \u2014\nattributable, never pre-authorised by us. Stamped by the runtime from the registration, so a\ncomponent cannot claim a posture it does not have.",
      "properties": {
        "at": {
          "title": "At",
          "type": "string"
        },
        "kind": {
          "const": "observed",
          "default": "observed",
          "title": "Kind",
          "type": "string"
        },
        "observation": {
          "discriminator": {
            "mapping": {
              "acted": "#/$defs/Acted",
              "asked": "#/$defs/shadow_hdk__kernel__observations__Asked",
              "completed": "#/$defs/Completed",
              "failed": "#/$defs/Failed",
              "pending": "#/$defs/Pending",
              "refused": "#/$defs/shadow_hdk__kernel__observations__Refused"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Completed"
            },
            {
